# The same service for an Intel GPU (Arc, also the integrated Arc of Core Ultra laptops), including under WSL2:
# PyTorch's xpu build and Intel's GPU runtime (Level Zero) instead of CUDA. app.py picks xpu when PyTorch has it.
# Under WSL the container also needs /dev/dxg and /usr/lib/wsl (cortex/deploy/gpu/intel.yml does it):
#   docker run --device /dev/dxg -v /usr/lib/wsl:/usr/lib/wsl:ro -e LD_LIBRARY_PATH=/usr/lib/wsl/lib ...
# Measured on an Arc 140V (WSL2, 2026-10-05): bge-reranker-v2-m3 in float16, 84 passages in 1.3 s (27 s for 40 on
# the 8-core CPU in float32), 1.1 GB of GPU memory.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    ZES_ENABLE_SYSMAN=1
# Intel's GPU runtime, from the archive llama.cpp's server-intel image uses
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common gpg-agent ca-certificates \
 && add-apt-repository -y ppa:kobuk-team/intel-graphics \
 && apt-get update && apt-get install -y --no-install-recommends libze1 libze-intel-gpu1 intel-opencl-icd \
      python3 python3-venv \
 && apt-get purge -y software-properties-common gpg-agent && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv \
 && /venv/bin/pip install --no-cache-dir torch==2.14.1 --index-url https://download.pytorch.org/whl/xpu \
 && /venv/bin/pip install --no-cache-dir "transformers>=4.40" fastapi "uvicorn[standard]" pydantic
ENV PATH=/venv/bin:$PATH
WORKDIR /app
COPY app.py /app/app.py
EXPOSE 8600
CMD ["uvicorn","app:app","--host","0.0.0.0","--port","8600","--log-level","warning"]
